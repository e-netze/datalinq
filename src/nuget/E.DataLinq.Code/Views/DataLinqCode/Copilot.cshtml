@using E.DataLinq.Code.Extensions
@using E.DataLinq.Code.Services
@using E.DataLinq.Core.Models
@using E.DataLinq.Core
@using Microsoft.Extensions.Options
@inject E.DataLinq.Core.Services.Localization.MarkdownLocalizer _localizer;

@{
    Layout = "~/Views/Shared/_Layout_empty-datalinq-code-copilot.cshtml";
    ViewBag.Title = "DataLinq Copilot";
}

<script src="~/_content/E.DataLinq.Code/js/datalinq-code-compile.js?@(DataLinqVersion.JsVersion)"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<div class="copilot-page">
    <div class="topbar">
        <div class="topbar-left">
            <span class="topbar-title">DataLinq Chat</span>
        </div>
        <div class="topbar-center">
            <div class="copilot-hints top-hint" onclick="" hidden>
                @_localizer["chatHistory"]
            </div>
        </div>
        <div class="topbar-right">
            <button class="topbar-btn" onclick="deleteHistory()" title="@_localizer["newChat"]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>
            <button class="topbar-btn" onclick="toggleChatHistory()" title="@_localizer["chatHistory"]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 3h5l2 3h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path>
                </svg>
            </button>
            <button class="topbar-btn" onclick="toggleExpand()" title="@_localizer["expand"]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 3h6v6"></path>
                    <line x1="21" y1="3" x2="14" y2="10"></line>
                    <path d="M9 21H3v-6"></path>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
            </button>
        </div>
    </div>
    <div id="copilot-intro">
        <img id="copilot-logo"
             src="~/_content/E.DataLinq.Code/css/img/datalinq_copilot_lightgrey.png"
             alt="DataLinq Copilot Logo"
             style="cursor:pointer" 
             onclick="switchMode()"/>
        <h1 class="copilot-heading">DataLinq Copilot</h1>
        <h4 class="copilot-heading">@_localizer["questionHeading"]</h4>

        <p class="copilot-paragraph">
            @_localizer["descriptionParagraph"] 
        </p><br />

        <div class="copilot-helpers">
            <p class="copilot-paragraph"><strong>@@</strong> @_localizer["copilotAtSymbol"]</p>
            <p class="copilot-paragraph"><strong>/</strong> @_localizer["copilotSlashSymbol"]</p>
            <p class="copilot-paragraph"><strong>#</strong> @_localizer["copilotHashtag"]</p>
        </div><br />

        <div class="copilot-suggestions">
            <button class="copilot-chip" type="button" onclick="explainCurrentCode()">@_localizer["copilotExplain"]</button>
            <button class="copilot-chip" type="button" onclick="sendMessageAsync('Create a table for me with filters and sorting options.')">@_localizer["copilotCreateExample"]</button>
            <button class="copilot-chip" type="button" onclick="sendMessageAsync('Write me example queries for SQL with #if.')">@_localizer["copilotQueryExample"]</button>
            <button class="copilot-chip" type="button" onclick="currentError()">@_localizer["copilotError"]</button>
        </div>
    </div>

    <div id="copilot-chat-history">

    </div>

    <div id="copilot-input" role="region" aria-label="@_localizer["copilotAriaForm"]">
        <div class="copilot-input-wrap">
            <textarea id="copilot-inputfield"
                      placeholder="@_localizer["copilotQuestion"]"
                      rows="1"
                      aria-label="@_localizer["copilotAriaInput"]"></textarea>
            <button id="copilot-submit" type="button" title="@_localizer["copilotAriaSubmit"]" aria-label="@_localizer["copilotAriaSubmit"]" onclick="sendMessageAsync()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 11L21 3L13 21L11 13L3 11Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
        <div class="copilot-hints">@_localizer["copilotHint"]</div>
    </div>

</div>


@section scripts {
    <script>
        
    </script>
}