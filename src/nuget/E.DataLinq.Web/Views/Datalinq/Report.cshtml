@foreach(var cssUrl in Options.CustomReportCssUrls)
{
    <link href="@(cssUrl.Replace("~", ViewData["appRootUrl"].ToString()))" rel="stylesheet" />
}

<link href="@(ViewData["contentRootUrl"])/lib/select2/css/select2.min.css" rel="stylesheet" />
<link href="@(ViewData["contentRootUrl"])/css/datalinq/datalinq.css?@(DataLinqVersion.CssVersion)" rel="stylesheet" />

<link href="@(ViewData["appRootUrl"])/datalinq/cssproxyendpoint/@(Model.EndpointId)?@(DataLinqVersion.CssVersion)" rel="stylesheet" />
<link href="@(ViewData["appRootUrl"])/datalinq/cssproxyview/@(Model.EndpointId)@@@(Model.QueryId)@@@(Model.ViewId)?@(DataLinqVersion.CssVersion)" rel="stylesheet" />

<link href="@(ViewData["contentRootUrl"])/lib/flatpickr/flatpickr.min.css" rel="stylesheet" />

<script src="@(ViewData["contentRootUrl"])/js/datalinq.js?@(DataLinqVersion.JsVersion)" id="datalinq-script"></script>
<script src="@(ViewData["contentRootUrl"])/js/datalinq.events.js?@(DataLinqVersion.JsVersion)"></script>
<script src="@(ViewData["contentRootUrl"])/js/datalinq.ui.js?@(DataLinqVersion.JsVersion)"></script>
<script src="@(ViewData["contentRootUrl"])/lib/select2/js/select2.min.js"></script>
<script src="@(ViewData["contentRootUrl"])/lib/select2/js/select2.min.js"></script>

<script src="@(ViewData["contentRootUrl"])/lib/momentjs/moment.min.js"></script>
<script src="@(ViewData["contentRootUrl"])/lib/momentjs/locale/de-at.js"></script>

<script src="@(ViewData["contentRootUrl"])/lib/flatpickr/flatpickr.min.js"></script>
<script src="@(ViewData["contentRootUrl"])/lib/flatpickr/l10n/de.js"></script>

@if (Model.IncludedJsLibraries.Contains(JsLibNames.Legacy_ChartJs))
{
    <script src="@(ViewData["contentRootUrl"])/js-legacy/chartjs/Chart.min.js"></script>

    @if (Model.IncludedJsLibraries.Contains(JsLibNames.Legacy_ChartJs_Plugin_DataLabels))
    {
        <script src="@(ViewData["contentRootUrl"])/js-legacy/chartjs/plugins/chartjs-plugin-datalabels.min.js"></script>
    }
    @if (Model.IncludedJsLibraries.Contains(JsLibNames.Legacy_ChartJs_Plugin_ColorSchemes))
    {
        <script src="@(ViewData["contentRootUrl"])/js-legacy/chartjs/plugins/chartjs-plugin-colorschemes.min.js"></script>
    }
}
@if (Model.IncludedJsLibraries.Contains(JsLibNames.ChartJs_3x))
{
    <script src="@(ViewData["contentRootUrl"])/lib/chartjs-3x/chart.min.js"></script>
    @if (Model.IncludedJsLibraries.Contains(JsLibNames.ChartJs_3x_Plugin_DataLabels))
    {
        <script src="@(ViewData["contentRootUrl"])/lib/chartjs-3x/plugins/chartjs-plugin-datalabels.min.js"></script>
    }
}

@if (Model.IncludedJsLibraries.Contains(JsLibNames.JsonEditor))
{
    <script src="@(ViewData["contentRootUrl"])/lib/jsoneditor/jsoneditor.min.js"></script>
    <link href="@(ViewData["contentRootUrl"])/lib/jsoneditor/jsoneditor.min.css" rel="stylesheet" type="text/css" />
}

@if (Model.IncludedJsLibraries.Contains(JsLibNames.D3_7x))
{
    <script src="@(ViewData["contentRootUrl"])/lib/d3-7x/d3.min.js"></script>

}

@if (Model.IncludedJsLibraries.Contains(JsLibNames.Mermaid))
{
    <script src="@(ViewData["contentRootUrl"])/lib/mermaid-11_20_0/mermaid.min.js"></script>
}

@foreach(var jsUrl in Options.CustomReportJavascriptUrls)
{   
    var keyValues = jsUrl.ToKeyValues("src");

    if (!String.IsNullOrEmpty(keyValues["id"]))
    {
        <script src="@(keyValues["src"].Replace("~", ViewData["appRootUrl"].ToString()))" id="@keyValues["id"]"></script>
    }
    else
    {
        <script src="@(keyValues["src"].Replace("~", ViewData["appRootUrl"].ToString()))"></script>
    }
}

<script src="@(ViewData["appRootUrl"])/datalinq/jsproxyendpoint/@(Model.EndpointId)?@(DataLinqVersion.CssVersion)"></script>
<script src="@(ViewData["appRootUrl"])/datalinq/jsproxyview/@(Model.EndpointId)@@@(Model.QueryId)@@@(Model.ViewId)?@(DataLinqVersion.JsVersion)"></script>

@if (Model.PDFReportMode)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link href="@(ViewData["contentRootUrl"])/css/datalinq/datalinq-pdf-report.css?@(DataLinqVersion.CssVersion)" rel="stylesheet" />
    <script src="@(ViewData["contentRootUrl"])/js/datalinq-pdf-report.js?@(DataLinqVersion.JsVersion)" id="datalinq-script"></script>
}

@if (Model.PDFReportEditing)
{
    <script src="@(ViewData["contentRootUrl"])/js/datalinq-pdf-report.editing.js?@(DataLinqVersion.JsVersion)" id="datalinq-script"></script>
}

<script type="text/javascript">

    dataLinq.__authObject=@Html.Raw(Model.ClientSideAuthObjectString);

    $(document).ready(function () {
        dataLinq.showSplashSreen('(c) '+(new Date()).getFullYear()+' Energienetze Steiermark GmbH', 2000);

        dataLinq.init();
    });
</script>

<div id="datalinq-body">
    @*
        @Html.Raw(Model.Html)
    *@

    <div style="position:absolute;top:0px;left:0px;width:100%;height:20px;text-align:right;font-size:12px;color:#808080;pointer-events:none;" id="datalinq-header">@Model.AuthIntialText</div>
    <div class="datalinq-include" data-source="@Model.Id" data-filter="@Model.QueryString" data-orderby="@Model.OrderBy">

    </div>
    <div class="legend">

    </div>

    @if (Model.PDFReportMode && !Model.PDFReportEditing)
    {
        <div id="datalinq-modal" class="modal-overlay">
            <div class="modal-container">
                <div class="modal-logo"></div>

                <div class="modal-content">
                    <h2>Browser Compatibility Notice</h2>
                    <p>To ensure optimal rendering and generation, please verify you are using one of the following supported browser versions:</p>

                    <div class="browser-list">
                        <h3>Supported Browsers</h3>
                        <ul>
                            <li>Mozilla Firefox 3.5 or later</li>
                            <li>Google Chrome (latest version)</li>
                            <li>Opera 12 or later</li>
                            <li>Internet Explorer 9 or later</li>
                            <li>Microsoft Edge (latest version)</li>
                            <li>Safari 6 or later</li>
                        </ul>
                    </div>
                </div>

                <div class="modal-buttons">
                    <button class="modal-button accept" id="accept-btn">Accept & Continue</button>
                    <button class="modal-button decline" id="decline-btn">Decline</button>
                </div>
            </div>
        </div>
    } 

    @if (Model.PDFReportEditing)
    {
        <script>
            dataLinq.events.on('onpageloaded', function () {
            var btn = document.getElementById("editingHelp");
            var modal = document.getElementById("pdfHelpModal");


            btn.onclick = function() {
                if (modal.style.display === "block") {
                    modal.style.display = "none";
                } else {
                    modal.style.display = "block";
                }
            }
            });
        </script>

        <!-- Trigger Button -->
        <button id="editingHelp">Help</button>

        <!-- The Modal -->
        <div id="pdfHelpModal" class="modal-overlay-help ">
            <div class="modal-content-help ">

                <h1>DataLinq PDF-Mode</h1>
                <p>Welcome to the DataLinq PDF-Mode, the documentation below shows how its functions can be used for creating PDF and providing them in various ways to the users. A list of supported and unsupported CSS properties can be found <a href="https://html2canvas.hertzen.com/features">here</a>.</p>
                <hr />

                <h3>General</h3>
                <hr />

                <ul class="help-list">
                    <li>To create a new PDF document in your view, you need to specify the start using <code>BeginPdfReport()</code> and the end using <code>EndPdfReport()</code>.</li>

                    <li>To create a page in the PDF use <code>NewPage()</code> and <code>EndPage()</code>. This will create an A4 sized page.</li>

                    <li>Inside of the page you can (but are not forced to) use <code>NewPdfElement</code> and <code>EndPdfElement</code> to declare an item that can be moved around with drag and drop & snapping.</li>

                    <li><strong>You are in "Editing Mode":</strong> This only changes the appearance on the client side. Changes do not directly impact the design of the PDF on the server.</li>

                    <li>To save changes, you need to copy over the coordinates of the element to the view in DataLinq code.</li>

                    <li>You can use the <strong>Left Mouse Click</strong> to drag and drop elements from one place to another.</li>

                    <li><strong>Right Clicking</strong> on an element will copy the whole coordinate line to your clipboard so you can paste it into the view. <br><em>Example:</em> <code>NewPdfElement(x: 288.375, y: 338)</code></li>

                    <li>After saving the new coordinates of the element will be saved and rendered in future PDF generations.</li>

                    <li>It is advised that the PDF-Editing-Mode is only activated while an administrator is activly working on a PDF-Template.</li>
                </ul>

                <h3>DataLinq Helper Functions</h3>
                <hr />

                <ul class="help-list">

                    <li>
                        <code>BeginPdfReport()</code> is used at the beginning of the DataLinq View that is to be turned into a PDF report.<br />
                        <ul class="help-list">
                            <li><b>pageNumberOptions</b>: Implements automatic page numbering, with the options to skip pages like a cover sheet, the choose a numbering style, as well as the position.</li>
                            <li><b>download_button</b>: Specifies whether a PDF-View comes with a download button to manually start the download. This should be used when a PDF is editable for the user or when the download is not triggered automatically.</li>
                        </ul>
                    </li>

                    <li><code>EndPdfReport()</code> is used to specify the end of a DataLinq PDF report.</li>

                    <li>
                        <code>NewPage()</code> creates a new Page. <br />
                        <ul class="help-list">
                            <li><b>pageTemplateOptions</b>: This allows you to apply PDF-View templates to the page instead of adding headers or footers manually.</li>
                            <li><b>dynamicTableOptions</b>: Allows you to specify whether Tables which are too long for a single A4 page should be split automatically. This can be used with footers/headers and with or without templates.</li>
                            <li><b>landscape</b>: Puts the page to which it is applied into landscape view.</li>
                        </ul>
                    </li>

                    <li><code>EndPage()</code> is used to specify the end of a page.</li>

                    <li>
                        <code>NewPdfElement()</code> creates a new PDF element around HTML-content to allow editing by drag&dropping with snapping instead of using CSS for positioning. The coordinates can be retrieved by right clicking on the element in editing mode.<br />
                        <ul class="help-list">
                            <li><b>x</b>: The x-coordinate of the element on the page.</li>
                            <li><b>y</b>: The y-coordinate of the element on the page.</li>
                        </ul>
                    </li>

                    <li><code>EndPdfElement()</code> is used to specify the end of a pdf element.</li>

                    <li>
                        <code>PrintPdfButton()</code> creates a button which allows to trigger a automatic download in the background of a specified PDF-Report. <br/>
                        <ul class="help-list">
                            <li><b>id</b>: The id of the DataLinq PDF-Report-View (@@endpointId@@queryId@@viewId).</li>
                            <li><b>parameters</b>: A list of parameters to be passed on to the report to call it with different Id's or parameters.</li>
                            <li><b>buttonText</b>: The text of the button.</li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>

    }
</div>