    <div class="datalinq-include" data-source="@Model.Id" data-filter="@Model.QueryString" data-orderby="@Model.OrderBy">

    </div>
    <div class="legend">

    </div>

    @if (Model.PDFCompatibilityNotice)
    {
        @Html.Partial("_PdfReportingBrowserCompatibilityNotice",Model);
    } 
</div>