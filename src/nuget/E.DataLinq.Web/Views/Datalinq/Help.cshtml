@using E.DataLinq.Core
@using E.DataLinq.Web.Models
@model E.DataLinq.Web.Models.HelpModel
@inject E.DataLinq.Core.Services.Abstraction.IHostUrlHelper HostUrlHelper

@{
    ViewBag.Title = "Help";
    Layout = "~/Views/Shared/_Layout_empty-datalinq.cshtml";

    var currentLang = Model.SelectedLanguage == "de" ? "de" : "en";
    var isDe = currentLang == "de";
    var helpRootUrl = $"{HostUrlHelper.HostAppRootUrl()}/datalinq/help";

    string T(string en, string de) => isDe ? de : en;

    bool IsDocumented(ClassHelp.MethodHelp m)
        => !String.IsNullOrWhiteSpace(m.Description) || !String.IsNullOrWhiteSpace(m.ShortDescription);

    string SearchText(IEnumerable<ClassHelp.MethodHelp> overloads)
        => String.Join(" ", overloads.SelectMany(m => new[] { m.Name, m.ShortDescription, m.Description }
                                                      .Concat(m.Parameters.Select(p => p.Name))))
                 .ToLowerInvariant();
}

<link href="@(ViewData["contentRootUrl"])/css/datalinq/help.css?@(DataLinqVersion.CssVersion)" rel="stylesheet" />
<script src="@(ViewData["contentRootUrl"])/js/datalinq.help.js?@(DataLinqVersion.CssVersion)"></script>

<div class="help-page" data-lang="@currentLang">

    @if (String.IsNullOrWhiteSpace(Model.Selected))
    {
        <header class="help-header">
            <div class="help-header-row">
                <div class="help-title">
                    <span class="help-title-main">DataLinq</span>
                    <span class="help-title-sub">@T("Help", "Hilfe")</span>
                </div>
                <div class="help-lang-switch" role="group" aria-label="Language">
                    <button type="button" class="@(isDe ? "" : "active")" data-lang="en">EN</button>
                    <button type="button" class="@(isDe ? "active" : "")" data-lang="de">DE</button>
                </div>
            </div>

            <div class="help-tabs" role="tablist">
                @for (var i = 0; i < Model.Classes.Count; i++)
                {
                    <button type="button" class="help-tab @(i == 0 ? "active" : "")" data-class-index="@i" role="tab">@@@Model.Classes[i].Alias</button>
                }
            </div>

            <div class="help-search">
                <input type="search" class="content-search" placeholder="@T("Search functions…", "Funktionen suchen…")" autocomplete="off" spellcheck="false" />
            </div>
        </header>

        <main class="help-main">
            @for (var i = 0; i < Model.Classes.Count; i++)
            {
                var classHelp = Model.Classes[i];
                var groups = new[]
                {
                    (Title: T("Methods", "Methoden"), Methods: classHelp.Methods),
                    (Title: T("Extension methods", "Erweiterungsmethoden"), Methods: classHelp.ExtensionMethods)
                }
                .Select(g => (g.Title, Names: g.Methods.Where(IsDocumented).Select(m => m.Name).Distinct().OrderBy(n => n).ToList(), g.Methods))
                .Where(g => g.Names.Count > 0)
                .ToList();

                <section class="class-panel @(i == 0 ? "active" : "")" data-class-index="@i">

                    @if (!String.IsNullOrWhiteSpace(classHelp.Description))
                    {
                        <details class="help-about">
                            <summary>
                                <span class="help-about-title">@@@classHelp.Alias</span>
                                <span class="help-about-short">@ClassHelp.FirstSentence(classHelp.Description, 200)</span>
                            </summary>
                            <div class="help-text">
                                @Html.Raw(ClassHelp.DescriptionToHtml(classHelp.Description, currentLang))
                            </div>
                        </details>
                    }

                    @foreach (var group in groups)
                    {
                        <div class="help-group">
                            @if (groups.Count > 1)
                            {
                                <h3 class="help-group-title">@group.Title</h3>
                            }

                            <div class="help-list-items">
                                @foreach (var name in group.Names)
                                {
                                    var overloads = group.Methods.Where(m => m.Name == name).ToList();
                                    var documented = overloads.OrderBy(m => m.Target is null ? 0 : 1).FirstOrDefault(IsDocumented) ?? overloads[0];

                                    <a class="help-item searchable-content"
                                       href="help?selected=@(Uri.EscapeDataString(classHelp.Name + "." + name))&lang=@currentLang"
                                       data-search="@SearchText(overloads)">
                                        <span class="help-item-head">
                                            <span class="help-item-name">@name</span>
                                            @if (overloads.Count > 1)
                                            {
                                                <span class="help-chip">@overloads.Count @T("overloads", "Überladungen")</span>
                                            }
                                        </span>
                                        <span class="help-item-short">@ClassHelp.ShortText(documented)</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <p class="help-empty help-no-results" hidden>@T("No functions match your search.", "Keine Funktionen gefunden.")</p>
                </section>
            }
        </main>
    }
    else
    {
        var selectedParts = Model.Selected.Split('.', 2);
        var helpClass = Model.Classes.FirstOrDefault(c => c.Name == selectedParts[0]);
        var methodName = selectedParts.Length > 1 ? selectedParts[1] : String.Empty;
        var firstMethod = helpClass?.Methods.Concat(helpClass.ExtensionMethods)
                                   .Where(m => m.Name == methodName)
                                   .OrderBy(m => m.Target is null ? 0 : 1)
                                   .FirstOrDefault();

        <header class="help-header help-header-detail">
            <div class="help-header-row">
                <a class="help-back" href="@helpRootUrl?lang=@currentLang">← @T("All functions", "Alle Funktionen")</a>
                <div class="help-lang-switch" role="group" aria-label="Language">
                    <button type="button" class="@(isDe ? "" : "active")" data-lang="en">EN</button>
                    <button type="button" class="@(isDe ? "active" : "")" data-lang="de">DE</button>
                </div>
            </div>
            <div class="help-detail-title">
                @if (helpClass != null)
                {
                    <span class="help-chip help-chip-alias">@@@(firstMethod?.Target ?? helpClass.Alias)</span>
                }
                <h1>@methodName</h1>
            </div>
            @if (firstMethod != null)
            {
                <p class="help-lead">@ClassHelp.ShortText(firstMethod)</p>
            }
        </header>

        <main class="help-main">
            @if (helpClass != null)
            {
                @Html.Raw(helpClass.ToHtmlString(methodName, currentLang))
            }
            else
            {
                <p class="help-empty">@T("No documentation found for this function.", "Für diese Funktion wurde keine Dokumentation gefunden.")</p>
            }
        </main>
    }
</div>
