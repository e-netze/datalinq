@using E.DataLinq.Core
@model E.DataLinq.Web.Models.HelpModel
@inject E.DataLinq.Core.Services.Abstraction.IHostUrlHelper HostUrlHelper

@{
    ViewBag.Title = "Help";
    Layout = "~/Views/Shared/_Layout_empty-datalinq.cshtml";
}

@{
    var currentLang = Model.SelectedLanguage ?? "en";
}

 <script src="@(ViewData["contentRootUrl"])/js/datalinq.help.js"></script>

<style>
    td {
        border: 1px solid #d4d4d4;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-container h2 {
        margin: 0;
    }

    .language-selector {
        margin-left: 10px; 
    }

    .language-selector select {
        font-size: 14px;
        padding: 5px;
        background-color: #f0f0f0;
        border: 1px solid #ccc;
        border-radius: 5px;
        cursor: pointer;
    }

    .language-selector select:focus {
        outline: none;
        border-color: #007bff;
    }

    .class-switcher {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 12px 0;
    }

    .class-switcher button {
        font-size: 14px;
        padding: 8px 14px;
        background-color: #f0f0f0;
        border: 1px solid #ccc;
        border-radius: 5px;
        cursor: pointer;
        color: #333;
    }

    .class-switcher button.active {
        background-color: #e0e0e0;
        border-color: #999;
    }

    .class-panel {
        display: none;
    }

    .class-panel.active {
        display: block;
    }

</style>

<link href="@(ViewData["contentRootUrl"])/css/datalinq/help.css?@(DataLinqVersion.CssVersion)" rel="stylesheet" />

@if (String.IsNullOrWhiteSpace(Model.Selected))
{
    <div class="header-container">
        <h2>DataLinq</h2>
        <div class="language-selector">
            <select id="languageSelector" onchange="changeLanguage(this)">
                <option value="en" @(currentLang == "en" ? "selected" : "")>EN</option>
                <option value="de" @(currentLang == "de" ? "selected" : "")>DE</option>
            </select>
        </div>
    </div>
    <br />

    <div class="class-switcher" id="classSwitcher">
        @{ var classIndex = 0; }
        @foreach (var classHelp in Model.Classes)
        {
            <button type="button" class="class-toggle @(classIndex == 0 ? "active" : "")" data-class-index="@classIndex">
                @@@classHelp.Alias
            </button>
            classIndex++;
        }
    </div>

    <input type='text' class='content-search' placeholder='Search...' />

    var panelIndex = 0;
    @foreach (var classHelp in Model.Classes)
    {
        <div class="class-panel @(panelIndex == 0 ? "active" : "")" data-class-index="@panelIndex">
            <h3>@classHelp.Name <small>(@@@classHelp.Alias)</small></h3>
            <p class="searchable-content">
                @classHelp.Description
            </p>

            <h4>Methods</h4>
            <table width="100%">
                @foreach (var methodName in classHelp.MethodNames.OrderBy(m => m))
                {
                    var method = classHelp.Methods.Where(m => m.Name == methodName).FirstOrDefault();
                    if (!String.IsNullOrWhiteSpace(method.Description))
                    {
                        <tr class="searchable-content">
                            <td>
                                <a href="help?selected=@(classHelp.Name + "." + methodName)&lang=@currentLang">@methodName</a>
                            </td>
                            <td>
                                <p>@method.Description.Split('.')[0]</p>
                            </td>
                        </tr>
                    }
                }
            </table>

            @if (classHelp.ExtensionMethodNames.Count > 0)
            {
                <br />
                <br />
                <h4>Extended Methods</h4>
                <table width="100%">
                    @foreach (var methodName in classHelp.ExtensionMethodNames.OrderBy(m => m))
                    {
                        var method = classHelp.ExtensionMethods.Where(m => m.Name == methodName).FirstOrDefault();
                        if (!String.IsNullOrWhiteSpace(method.Description))
                        {
                            <tr class="searchable-content">
                                <td>
                                    <a href="help?selected=@(classHelp.Name + "." + methodName)&lang=@currentLang">@methodName</a>
                                </td>
                                <td>
                                    <p>@method.Description.Split('.')[0]</p>
                                </td>
                            </tr>
                        }
                    }
                </table>
            }
        </div>
        panelIndex++;
    }
}
else
{
    <a href="@(HostUrlHelper.HostAppRootUrl())/datalinq/help?lang=@currentLang">&lt;&lt; All Methods</a>

    <h1>@Model.Selected</h1>

    var helpClass = Model.Classes.Where(c => c.Name == Model.Selected.Split('.')[0]).FirstOrDefault();

    @Html.Raw(helpClass.ToHtmlString(Model.Selected.Split('.')[1]))
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var languageSelector = document.getElementById("languageSelector");

        if (languageSelector) {
            var storedLang = sessionStorage.getItem("selectedLang");
            var currentLang = languageSelector.value;

            if (storedLang && storedLang !== currentLang) {
                languageSelector.value = storedLang;
                var url = new URL(window.location.href);
                url.searchParams.set("lang", storedLang);
                window.location.href = url.toString();
                return;
            }
        }

        var panels = Array.from(document.querySelectorAll(".class-panel"));
        var toggles = Array.from(document.querySelectorAll(".class-toggle"));

        function applySearch() {
            var input = document.querySelector("input.content-search");
            if (input && window.applyHelpSearch) {
                window.applyHelpSearch(input);
            }
        }

        function setActiveClass(classIndex) {
            panels.forEach(function (panel) {
                var isActive = panel.getAttribute("data-class-index") === classIndex;
                panel.classList.toggle("active", isActive);
            });

            toggles.forEach(function (toggle) {
                toggle.classList.toggle("active", toggle.getAttribute("data-class-index") === classIndex);
            });

            sessionStorage.setItem("selectedHelpClass", classIndex);
            applySearch();
        }

        if (panels.length > 0) {
            var storedClass = sessionStorage.getItem("selectedHelpClass");
            var initialClass = storedClass && panels.some(function (panel) { return panel.getAttribute("data-class-index") === storedClass; })
                ? storedClass
                : panels[0].getAttribute("data-class-index");

            setActiveClass(initialClass);

            toggles.forEach(function (toggle) {
                toggle.addEventListener("click", function () {
                    setActiveClass(toggle.getAttribute("data-class-index"));
                });
            });
        }
    });

    function changeLanguage(select) {
        var selectedLang = select.value;
        sessionStorage.setItem("selectedLang", selectedLang);
        window.parent.postMessage({ lang: selectedLang }, '*');
        var url = new URL(window.location.href);
        url.searchParams.set("lang", selectedLang);
        window.location.href = url.toString();
    }
</script>

