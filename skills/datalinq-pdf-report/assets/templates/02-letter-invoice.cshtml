@* Letter / invoice: one document per record of the main query, positions from a second query.
   Replace column names (UPPER CASE placeholders) with the real ones from `sample`.
   Second query id: replace "ENDPOINT@POSITIONS_QUERY". *@
@{
    string V(IDictionary<string, object> rec, string key) =>
        rec != null && rec.ContainsKey(key) && rec[key] != null && !(rec[key] is DBNull) ? rec[key].ToString() : "";
    decimal D(IDictionary<string, object> rec, string key) =>
        decimal.TryParse(V(rec, key), out var d) ? d : 0m;
    string Dt(IDictionary<string, object> rec, string key) =>
        DateTime.TryParse(V(rec, key), out var dt) ? dt.ToString("dd.MM.yyyy") : V(rec, key);
}
@PDF.BeginReport(
    pageNumberOptions: new PageNumberOptions { UsePageNumbers = true, Position = 2 },
    fileName: "Rechnung")

@if (Model.Records == null || Model.Records.Length == 0)
{
    @PDF.NewPage()
        <p style="padding:20mm">No data found.</p>
    @PDF.EndPage()
}

@foreach (var r in Model.Records)
{
    var positions = await DLH.GetRecordsAsync("ENDPOINT@POSITIONS_QUERY", filter: "INVOICE_ID=" + V(r, "INVOICE_ID"), orderby: "POS")
                    ?? new IDictionary<string, object>[0];
    var total = positions.Sum(p => D(p, "AMOUNT"));

    @PDF.NewPage(dynamicTableOptions: new DynamicTableOptions { Dynamic = true, DefaultMarginTop = 60, DefaultMarginBottom = 70 })
        <style>
            .rpt-inv { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #222; }
            .rpt-inv p, .rpt-inv td, .rpt-inv th { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; line-height: 1.35; }
            .rpt-inv-table td, .rpt-inv-table th { font-family: Arial, Helvetica, sans-serif; font-size: 9pt; line-height: 1.3; }
            .rpt-inv-head { box-sizing: border-box; padding: 18mm 18mm 0 20mm; display: flex; justify-content: space-between; }
            .rpt-inv-addr { box-sizing: border-box; padding: 12mm 18mm 0 20mm; height: 45mm; }
            .rpt-inv-meta { box-sizing: border-box; padding: 0 18mm 6mm 20mm; display: grid; grid-template-columns: 35mm 1fr; row-gap: 1mm; }
            .rpt-inv-table { border-collapse: collapse; width: calc(100% - 38mm); margin: 0 18mm 0 20mm; font-size: 9pt; }
            .rpt-inv-table th { text-align: left; border-bottom: 1px solid #333; padding: 1.5mm 2mm; }
            .rpt-inv-table td { border-bottom: 1px solid #ddd; padding: 1.5mm 2mm; }
            .rpt-inv-table .num { text-align: right; white-space: nowrap; }
            .rpt-inv-total { margin: 4mm 18mm 0 20mm; text-align: right; font-weight: bold; font-size: 11pt; }
        </style>
        <div class="rpt-inv rpt-inv-head">
            <div><strong>COMPANY NAME</strong><br />Street 1<br />1234 City</div>
            <div style="width:30mm;height:15mm;border:1px dashed #aaa;text-align:center;line-height:15mm">Logo</div>
        </div>
        <div class="rpt-inv rpt-inv-addr">
            @V(r, "CUSTOMER_NAME")<br />
            @V(r, "CUSTOMER_STREET")<br />
            @V(r, "CUSTOMER_ZIP") @V(r, "CUSTOMER_CITY")
        </div>
        <div class="rpt-inv rpt-inv-meta">
            <h2 style="grid-column:1 / span 2;margin:0 0 3mm 0;font-size:16pt">Invoice @V(r, "INVOICE_NO")</h2>
            <span>Date:</span><span>@Dt(r, "INVOICE_DATE")</span>
            <span>Customer no.:</span><span>@V(r, "CUSTOMER_NO")</span>
        </div>
        <table class="rpt-inv rpt-inv-table">
            <thead>
                <tr><th>Pos</th><th>Description</th><th class="num">Qty</th><th class="num">Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var p in positions)
                {
                    <tr>
                        <td>@V(p, "POS")</td>
                        <td>@V(p, "TEXT")</td>
                        <td class="num">@V(p, "QTY")</td>
                        <td class="num">@(D(p, "AMOUNT").ToString("#,##0.00"))</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="rpt-inv rpt-inv-total">Total: @(total.ToString("#,##0.00")) EUR</div>
    @PDF.EndPage()
}

@PDF.EndReport()
